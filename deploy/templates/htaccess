# Seul dossier servi par le web : autorise explicitement ce qui est refusé à la racine du projet.
Require all granted

DirectoryIndex index.php

# Force HTTPS (méthode préconisée par IONOS). Le cookie de session est « Secure » en production : sans HTTPS, pas de connexion.
# Redirection temporaire (302) : à passer en 301 une fois validée sur l'hébergement.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{SERVER_PORT} !=443
    RewriteRule ^ https://__HOST__%{REQUEST_URI} [R=302,L]
</IfModule>

# Front controller sans mod_rewrite (la réécriture renvoyait un 500 sur IONOS).
# Chemin depuis la racine du site, rempli par deploy.sh (ex. /projet/CN95/public/index.php)
FallbackResource __FRONT_CONTROLLER__

<IfModule mod_headers.c>
    # Ignoré par les navigateurs en HTTP ; en HTTPS, impose HTTPS pendant 1 an
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Content-Security-Policy : envoyée par l'application (nonce par requête), voir App\Security\ContentSecurityPolicySubscriber
</IfModule>
