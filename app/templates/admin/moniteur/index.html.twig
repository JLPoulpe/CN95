{% extends 'base.html.twig' %}
{% block title %}Moniteur par groupe – CN95 Plongée{% endblock %}
{% block body %}
<div class="container container-wide"
     data-controller="moniteur-groupes"
     data-moniteur-groupes-url-value="{{ path('admin_moniteur_groupes') }}"
     data-moniteur-groupes-token-value="{{ csrf_token('moniteur_groupes') }}">
    <h1 class="header-title">Moniteur par groupe</h1>

    <p class="hint">Glissez un moniteur du tableau vers un groupe pour l'y ajouter, d'un groupe à un autre pour le déplacer, ou d'un groupe vers le tableau pour l'en retirer.</p>
    <p class="hint" data-moniteur-groupes-target="statut" hidden role="status"></p>
    <div class="groupes">
        {% for g in groupes %}
            <div class="groupe" data-groupe-id="{{ g.aptitude.id }}"
                 data-action="dragover->moniteur-groupes#survol dragleave->moniteur-groupes#quitte drop->moniteur-groupes#depotGroupe">
                <div class="groupe-titre">{{ g.aptitude.codePlanning }}</div>
                {% if g.moniteurs %}
                    <ul>{% for m in g.moniteurs %}<li draggable="true" data-moniteur-id="{{ m.id }}" data-source-id="{{ g.aptitude.id }}" data-action="dragstart->moniteur-groupes#debut dragend->moniteur-groupes#fin">{{ m.nomComplet|title }}</li>{% endfor %}</ul>
                {% else %}
                    <p class="note">Aucun moniteur</p>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    <div class="table-wrapper" data-action="dragover->moniteur-groupes#survol dragleave->moniteur-groupes#quitte drop->moniteur-groupes#depotTableau">
        <table>
            <thead><tr><th>Nom</th><th>Prénom</th><th>Aptitudes</th><th></th></tr></thead>
            <tbody>
            {% for m in moniteurs %}
                <tr draggable="true" data-moniteur-id="{{ m.id }}" data-action="dragstart->moniteur-groupes#debut dragend->moniteur-groupes#fin">
                    <td><strong>{{ m.nom }}</strong></td>
                    <td>{{ m.prenom }}</td>
                    <td>{% for a in m.aptitudesEncadrees %}<span class="badge">{{ a.codePlanning }}</span> {% endfor %}</td>
                    <td><a class="btn btn-sm btn-secondary" href="{{ path('admin_moniteur_edit', {id: m.id}) }}">Éditer</a></td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucun moniteur (attribuer le rôle Moniteur depuis la gestion des utilisateurs).</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
