{% extends 'base.html.twig' %}
{% import 'member/_bandeau.html.twig' as m %}
{% block title %}Espace administrateur – CN95 Plongée{% endblock %}
{% block body %}
<div class="container">
    {% if is_granted('ROLE_ADMIN') %}
    <div class="section">
        <div class="section-title">Inscription</div>
        {% for activite in activitesExternes %}
            {{ m.item('📝', activite.libelle, 'Consulter et gérer les inscriptions', path('admin_invitation_index', {activiteExterneId: activite.id})) }}
        {% else %}
            <p>Aucune activité externe n'est configurée.</p>
        {% endfor %}
    </div>
    <div class="section">
        <div class="section-title">Communication</div>
        {{ m.item('📋', 'Activités externes', 'Consulter et gérer les invitations par activité', path('admin_invitation_index_defaut')) }}
        {{ m.item('💬', 'Communication générale', 'Envoyer des communications générales') }}
        {{ m.item('📱', 'Réseaux sociaux', 'Gérer les publications sur les réseaux sociaux') }}
    </div>
    <div class="section">
        <div class="section-title">Gestion utilisateur</div>
        {{ m.item('👥', 'Liste des utilisateurs', 'Consulter tous les utilisateurs', path('admin_user_index')) }}
        {{ m.item('➕', 'Ajout d\'un utilisateur', 'Créer un nouvel utilisateur', path('admin_user_new')) }}
        {{ m.item('⚙️', 'Configuration des activités', 'Aptitudes, activités, lignes d\'eau, planning et sondages', path('admin_configuration_activites')) }}
    </div>
    <div class="section">
        <div class="section-title">⚠️ Configuration de l'outil</div>
        {{ m.item('✉️', 'Configuration des mails', 'Choisir le système d\'envoi et ses paramètres', path('admin_mail_config')) }}
    </div>
    {% endif %}
</div>
{% endblock %}
