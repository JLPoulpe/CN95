{% extends 'base.html.twig' %}
{% block title %}{{ titre }} – CN95 Plongée{% endblock %}
{% block body %}
<div class="container">
    <h1 class="header-title">{{ titre }} <small style="font-size:16px;color:#6b7280">(S{{ semaine.lundi|date('W') }})</small></h1>
    <div class="card">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn" type="submit">Enregistrer</button>
            <a href="{{ path('admin_planning_edit', {id: semaine.id}) }}" style="margin-left:12px">Annuler</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
