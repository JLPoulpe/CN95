{% extends 'base.html.twig' %}
{% block title %}Connexion – CN95 Plongée{% endblock %}
{% block body %}
<div class="container login-box">
    <h1 class="header-title">Connexion</h1>
    <form method="post" class="card" data-controller="csrf-protection">
        {% if error %}<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
        <div class="form-row">
            <label for="username">Identifiant</label>
            <input type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
        </div>
        <div class="form-row">
            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="_password" autocomplete="current-password" required>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button class="btn" type="submit">Se connecter</button>
    </form>
</div>
{% endblock %}
