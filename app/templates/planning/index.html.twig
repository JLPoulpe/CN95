{% extends 'base.html.twig' %}
{% block title %}Planning semaine {{ lundi|date('W') }} – CN95 Plongée{% endblock %}
{% block body %}
<div class="container planning">
    <h1 class="header-title">Planning</h1>

    <div class="week-nav">
        {% if precedente %}
            <a class="week-btn" href="{{ path('app_planning', {date: precedente|date('Y-m-d')}) }}" aria-label="Semaine précédente">‹</a>
        {% else %}
            <span class="week-btn disabled" aria-hidden="true">‹</span>
        {% endif %}
        <div class="week-title">
            <strong>Semaine {{ lundi|date('W') }}</strong>
            <span>du {{ lundi|date('d/m') }} au {{ lundi|date_modify('+6 days')|date('d/m/Y') }}</span>
            <em{% if not estCourante %} class="invisible" aria-hidden="true"{% endif %}>Cette semaine</em>
        </div>
        {% if suivante %}
            <a class="week-btn" href="{{ path('app_planning', {date: suivante|date('Y-m-d')}) }}" aria-label="Semaine suivante">›</a>
        {% else %}
            <span class="week-btn disabled" aria-hidden="true">›</span>
        {% endif %}
    </div>

    {% if not estCourante %}<p class="week-today"><a class="btn btn-sm btn-secondary" href="{{ path('app_planning') }}">Aujourd'hui</a></p>{% endif %}

    {% include 'planning/_semaine.html.twig' %}
</div>
{% endblock %}
