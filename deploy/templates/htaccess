# Seul dossier servi par le web : autorise explicitement ce qui est refusé à la racine du projet.
Require all granted

DirectoryIndex index.php

# Front controller sans mod_rewrite (la réécriture renvoyait un 500 sur IONOS).
# Chemin depuis la racine du site, rempli par deploy.sh (ex. /projet/CN95/public/index.php)
FallbackResource __FRONT_CONTROLLER__

<IfModule mod_headers.c>
    # Ignoré par les navigateurs en HTTP ; en HTTPS, impose HTTPS pendant 1 an
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
</IfModule>
