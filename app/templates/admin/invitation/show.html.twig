{% extends 'base.html.twig' %}
{% block title %}Invitation – {{ invitation.activite.libelle }} – CN95 Plongée{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('vendor/quill/dist/quill.snow.css') }}">
{% endblock %}
{% block body %}
<div class="container">
    <p class="retour"><a href="{{ path('admin_invitation_index', {activiteExterneId: invitation.activite.id}) }}">← {{ invitation.activite.libelle }}</a></p>
    <h1 class="header-title">{{ invitation.activite.libelle }} du {{ invitation.date|date('d/m/Y') }}</h1>

    <div class="card">
        <dl class="fiche">
            <dt>Activité</dt><dd>{{ invitation.activite }}</dd>
            <dt>Date</dt><dd>{{ invitation.date|date('d/m/Y') }}</dd>
            <dt>Aptitudes conviées</dt><dd>{{ invitation.aptitudes|map(a => a.code)|join(', ') }}</dd>
            <dt>Visible par</dt><dd>{{ invitation.roles|map(r => r.libelle)|join(', ') }}</dd>
            <dt>État</dt>
            <dd>
                {% if invitation.annulee %}<span class="badge badge-grey">Annulée</span>
                {% elseif invitation.passee %}<span class="badge badge-grey">Passée</span>
                {% else %}<span class="badge badge-yellow">Active</span>{% endif %}
            </dd>
            <dt>Réponses</dt>
            <dd>{{ compte.inscrits }} inscrit(s) · {{ compte.refus }} ne participe pas · {{ compte.desistements }} désistement(s) · {{ compte.sans_reponse }} sans réponse</dd>
        </dl>
    </div>

    <div class="card">
        {% if invitation.envoyable %}
            {{ form_start(editForm) }}
                <h2 class="card-titre">Responsable et commentaire</h2>
                {% if invitation.activite.necessiteResponsable %}{{ form_row(editForm.dp) }}{% endif %}
                {{ form_row(editForm.commentaire, {label: 'Commentaire du mail'}) }}
                <button class="btn btn-sm" type="submit">Enregistrer les modifications</button>
            {{ form_end(editForm) }}
        {% else %}
            <h2 class="card-titre">Responsable et commentaire</h2>
            {% if invitation.activite.necessiteResponsable %}
                <dl class="fiche" style="margin-bottom:20px">
                    <dt>Responsable</dt>
                    <dd>{% if invitation.dp %}{{ invitation.dp.prenom }} {{ invitation.dp.nom }}{% else %}<span class="muted">Aucun</span>{% endif %}</dd>
                </dl>
            {% endif %}
            <p class="hint" style="margin-bottom:8px">Commentaire du mail :</p>
            {% if commentaire %}
                <div class="contenu-riche">{{ commentaire|raw }}</div>
            {% else %}
                <p class="muted">Aucun commentaire.</p>
            {% endif %}
        {% endif %}
    </div>

    <div class="actions-bar">
        <a class="btn btn-secondary" href="{{ path('admin_invitation_inscrits', {id: invitation.id}) }}">Voir les inscrits</a>
        <a class="btn btn-secondary" href="{{ path('admin_invitation_interactions', {id: invitation.id}) }}">Voir les membres ayant répondu</a>

        {% if invitation.envoyable %}
            <form method="post" action="{{ path('admin_invitation_relancer', {id: invitation.id}) }}"
                  onsubmit="return confirm('Renvoyer l\'invitation aux membres sans réponse ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('invitation_relancer_' ~ invitation.id) }}">
                <button class="btn btn-secondary" type="submit" {% if compte.sans_reponse == 0 %}disabled{% endif %}>Renvoyer les invitations</button>
            </form>

            <form method="post" action="{{ path('admin_invitation_annuler', {id: invitation.id}) }}"
                  onsubmit="return confirm('Annuler cette invitation ? Les membres ayant répondu seront prévenus.')">
                <input type="hidden" name="_token" value="{{ csrf_token('invitation_annuler_' ~ invitation.id) }}">
                <button class="btn btn-danger" type="submit">Annuler l'invitation</button>
            </form>
        {% endif %}

        <form method="post" action="{{ path('admin_invitation_delete', {id: invitation.id}) }}"
              onsubmit="return confirm('Supprimer définitivement cette invitation et toutes ses réponses ?')">
            <input type="hidden" name="_token" value="{{ csrf_token('invitation_delete_' ~ invitation.id) }}">
            <button class="btn btn-danger" type="submit">Supprimer l'invitation</button>
        </form>
    </div>
</div>
{% endblock %}
