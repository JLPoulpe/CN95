<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Fiche de sécurité club</title>
<style>
    @page { margin: 8mm 8mm 6mm 8mm; }
    body { font-family: Helvetica, sans-serif; font-size: 7.5pt; color: #111; margin: 0; }
    table { border-collapse: collapse; width: 100%; }
    td { padding: 0 2px; vertical-align: middle; }
    .box { display: inline-block; width: 7px; height: 7px; border: 1px solid #111; margin: 0 2px -1px 4px; }
    .titre { font-size: 13pt; letter-spacing: .3px; }
    .ucpa { text-align: right; font-size: 15pt; font-weight: bold; letter-spacing: 2px; line-height: 1; }
    .ucpa small { display: block; font-size: 8pt; font-weight: normal; letter-spacing: 2px; white-space: nowrap; }
    .cadre td { border: 1px solid #111; height: 4.6mm; }
    .centre { text-align: center; }
    .gras { font-weight: bold; }
    .valeur { font-size: 8pt; font-weight: bold; }
    .note { text-align: center; font-size: 7.6pt; margin: 1.6mm 0 0.8mm; }
    .note-fine { text-align: center; font-size: 6.6pt; margin: 0.8mm 0; }
    .apnee td { border: 1px solid #111; height: 3.6mm; font-size: 7.4pt; }
    .apnee .sep { border-top: 0; border-bottom: 0; width: 1.2mm; padding: 0; }
    .apnee .t { border-bottom: 0; font-size: 8.2pt; }
    .apnee .niv { text-align: right; width: 16mm; font-size: 7pt; }
    .blocs { margin-top: 0.6mm; }
    .blocs > tbody > tr > td { padding: 0; vertical-align: top; border: 1px solid #111; }
    .blocs .gap { border-top: 0; border-bottom: 0; width: 1.2mm; }
    .pal { width: 100%; }
    .pal td { border: 1px solid #555; height: 3.9mm; font-size: 7.6pt; overflow: hidden; white-space: nowrap; padding: 0 1.5px; }
    .pal .tete { font-size: 7.6pt; border-left: 0; border-right: 0; }
    .pal .niv { width: 17mm; text-align: center; border-right: 0; }
    .pal .lib { border-left: 0; }
    .pal .nom { border-left: 0; font-weight: bold; }
    .pal td.sans { border-left: 0; border-right: 0; border-top: 0; border-bottom: 0; height: 4.2mm; font-size: 7pt; }
    .param { text-align: center; }
    .param td { border: 0; height: 3.5mm; font-size: 6.8pt; padding: 0 1.5px; text-align: left; white-space: nowrap; }
    .param .main td { height: 5.2mm; vertical-align: bottom; padding-bottom: 0.6mm; }
    .param .t { text-align: center; font-size: 7.2pt; }
    .param .r { text-align: left; padding-left: 3px; }
    .param .ligne td { border-top: 1px dashed #555; }
    .bas td { vertical-align: top; }
    .bas .total td { border: 1px solid #111; height: 6mm; font-size: 10pt; vertical-align: middle; }
    .pointilles { display: inline-block; border-bottom: 1px dotted #111; min-width: 78mm; font-weight: bold; }
    .petit { font-size: 6.8pt; line-height: 1.35; }
</style>
</head>
<body>
{% set total = feuilles|length %}
{% for feuille in feuilles %}
<div{% if not loop.last %} style="page-break-after: always"{% endif %}>
    <table>
        <tr>
            <td style="width:84mm; padding:0; white-space:nowrap"><span class="titre">FICHE DE SECURITE CLUB</span></td>
            <td style="width:52mm" class="centre"><span class="box" style="margin-left:0"></span> PASS Club/Entrée Public</td>
            <td style="width:32mm"><span class="box"></span> Créneaux Club</td>
            <td style="padding:0"><div class="ucpa">UCPa<small>SPORT ACCESS</small></div></td>
        </tr>
    </table>

    <table class="cadre" style="margin-top:1.2mm">
        <tr>
            <td style="width:58mm">DATE : <span class="valeur">{{ date|date('d/m/Y') }}</span></td>
            <td style="width:70mm">HEURE DEBUT :</td>
            <td>HEURE FIN :</td>
        </tr>
    </table>
    <table class="cadre" style="border-top:0">
        <tr>
            <td style="border-top:0">NOM DU CLUB : <span class="valeur">{{ club }}</span></td>
            <td style="width:44mm; border-top:0">N° <span class="valeur">{% if total > 1 %}{{ loop.index }}/{{ total }}{% endif %}</span></td>
        </tr>
    </table>
    <table class="cadre">
        <tr>
            <td style="border-top:0">NOM DU PRESIDENT :</td>
            <td style="width:70mm; border-top:0">Présent sur le site <span class="box"></span> oui <span class="box"></span> non</td>
        </tr>
    </table>
    <table class="cadre">
        <tr><td style="border-top:0">DIRECTEUR DE PLONGEE : <span class="valeur">{{ dp }}</span></td></tr>
    </table>

    <p class="note">Présence du Directeur de plongée obligatoire, minimum niveau 3 d'encadrement</p>
    <p class="note-fine" style="margin-top:0">La pratique de l'apnée est conditionée par la convention. L'entrainement dans la fosse -10m est réservé au préparation N°4</p>

    {# Entraînement apnée : affiché, jamais rempli #}
    <table class="apnee">
        <tr>
            {% for i in 1..3 %}
                <td colspan="2" class="t" width="32.8%" style="width:32.8%">Entraînement apnée</td>{% if not loop.last %}<td class="sep" width="0.8%" style="width:0.8%"></td>{% endif %}
            {% endfor %}
        </tr>
        <tr>
            {% for i in 1..3 %}
                <td class="t" style="border-top:0; width:75%; white-space:nowrap">Noms et Prénoms</td><td class="niv" style="border-bottom:0; width:25%"></td>{% if not loop.last %}<td class="sep" width="0.8%" style="width:0.8%"></td>{% endif %}
            {% endfor %}
        </tr>
        {% for ligne in ['E3 mini.', 'Prépa N°4', 'Prépa N°4', 'Prépa N°4', 'Prépa N°4'] %}
        <tr>
            {% for i in 1..3 %}
                <td></td><td class="niv">{{ ligne }}</td>{% if not loop.last %}<td class="sep" width="0.8%" style="width:0.8%"></td>{% endif %}
            {% endfor %}
        </tr>
        {% endfor %}
    </table>

    <p class="note-fine gras" style="margin-bottom:0">Préciser les Aptitudes E1, E2, E3, E4 pour les encadrants; PE12; PE20; PA12; PA20 pour les plongeurs.</p>
    <p class="note-fine" style="margin-top:0">Obligation d'avoir un parachute par palanquée.</p>

    <table class="blocs">
        {% for ligne in feuille %}
        <tr>
            {% for p in ligne %}
            <td width="32.8%" style="width:32.8%">
                <table class="pal">
                    <tr>
                        <td class="tete nom" style="border-left:0; border-top:0; font-weight:normal; width:73%">Nom et Prenom de l'encadrant</td>
                        <td class="tete niv" style="border-top:0; width:27%">Niveau</td>
                    </tr>
                    <tr>
                        <td class="nom">{{ p.encadrant }}</td>
                        <td class="niv">{{ p.niveau }}</td>
                    </tr>
                    <tr>
                        <td class="lib">Noms et prénoms des plongeurs</td>
                        <td class="niv">Aptitudes</td>
                    </tr>
                    {% for pl in p.plongeurs %}
                    <tr>
                        <td class="nom" style="font-weight:normal">{{ pl.nom }}</td>
                        <td class="niv">{{ pl.niveau }}</td>
                    </tr>
                    {% endfor %}
                </table>
                <table class="param">
                    <tr><td colspan="2" class="t" style="border-top:1px solid #555">Paramètres de la plongée prévus:</td></tr>
                    <tr>
                        <td style="width:50%">Profondeur max: <b>{{ p.profondeur is not null ? p.profondeur ~ 'm' : '' }}</b></td>
                        <td class="r">Durée: <b>{{ p.duree is not null ? p.duree ~ "'" : '' }}</b></td>
                    </tr>
                    <tr class="ligne"><td colspan="2" class="t" style="border-top:1px dashed #555">Paramètres de la plongée réalisés:</td></tr>
                    <tr class="main"><td>Profondeur max:</td><td class="r">Durée:</td></tr>
                    <tr class="main"><td>Palier(s): &nbsp;&nbsp;&nbsp; Prof:</td><td class="r">Durée:</td></tr>
                    <tr class="main"><td style="padding-left:11mm">Prof:</td><td class="r">Durée:</td></tr>
                </table>
            </td>
            {% if not loop.last %}<td class="gap" width="0.8%" style="width:0.8%"></td>{% endif %}
            {% endfor %}
        </tr>
        {% endfor %}
    </table>

    <table class="bas" style="margin-top:2.5mm">
        <tr>
            <td style="width:126mm; padding-right:4mm">
                <p style="margin:0 0 1mm; font-size:8pt">Je soussigné(e), Mr, Mme <span class="pointilles">{{ dp }}</span></p>
                <p class="petit" style="margin:0">agissant en qualité de Directeur de plongée, certifie avoir pris connaissance et accepté le réglement intérieur, les conditions générales et particulières d'inscription et d'assurance de l'UCPA, ainsi que les conditions d'organisation et en avoir informé l'ensemble des encadrants et plongeurs figurant sur la feuille de sécurité.</p>
                <p style="margin:7mm 0 0; font-size:8.5pt">Signature du Directeur de plongée :</p>
            </td>
            <td>
                <table class="total">
                    <tr><td style="width:40mm; font-size:10pt">Nombre d'adultes</td><td class="centre gras">{{ adultes }}</td></tr>
                    <tr><td style="font-size:10pt">Nombre de mineurs*</td><td class="centre gras">{{ mineurs }}</td></tr>
                    <tr><td style="font-size:10pt" class="gras">Effectif total</td><td class="centre gras">{{ effectif }}</td></tr>
                </table>
                <div style="border:1px solid #111; border-top:0; text-align:center; padding:1.2mm 1mm" class="petit">
                    <b>*Autorisation parentale obligatoire</b><br>(sauf présence d'un parent)<br>conservée par le centre UCPA AQUA92
                </div>
            </td>
        </tr>
    </table>
</div>
{% endfor %}
</body>
</html>
