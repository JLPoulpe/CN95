{% extends 'base.html.twig' %}
{% block title %}Changer mon mot de passe – CN95 Plongée{% endblock %}
{% block body %}
<div class="container login-box">
    <h1 class="header-title">Changer mon mot de passe</h1>
    <div class="card">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn" type="submit">Enregistrer</button>
            <a href="{{ path('app_profil') }}" style="margin-left:12px">Annuler</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
