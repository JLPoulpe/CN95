{% extends 'base.html.twig' %}
{% block title %}Gestion du planning – CN95 Plongée{% endblock %}
{% block body %}
<div class="container container-wide">
    <h1 class="header-title">Gestion du planning</h1>
    {% if is_granted('PERM_CONFIG_ACTIVITES') %}
    <p class="toolbar">
        <a class="btn" href="{{ path('admin_planning_new') }}">Nouvelle semaine</a>
    </p>
    {% endif %}
    {% if activites|length %}
    <div class="section">
        <div class="section-title">Voir les créneaux par activité</div>
        <p>
        {% for a in activites %}
            <a class="btn btn-sm btn-secondary" href="{{ path('admin_planning_par_activite', {id: a.id}) }}">{{ a.libelle }}</a>
        {% endfor %}
        </p>
    </div>
    {% endif %}
    <div class="table-wrapper">
        <table>
            <thead><tr><th>Semaine</th><th>Du lundi</th><th>DP lundi</th><th>DP vendredi</th><th>État</th><th></th></tr></thead>
            <tbody>
            {% for s in semaines %}
                <tr>
                    <td><strong>S{{ s.lundi|date('W') }}</strong>{% if s.lundi < courante %} <span class="badge badge-grey">passée</span>{% endif %}</td>
                    <td>{{ s.lundi|date('d/m/Y') }}</td>
                    <td>{{ s.dp ?? '–' }}</td>
                    <td>{{ s.dpVendredi ?? 'Identique au lundi' }}</td>
                    <td>{% if s.fermee %}<span class="badge badge-yellow">Fermée{% if s.motif %} – {{ s.motif }}{% endif %}</span>{% else %}{{ s.creneaux|length }} créneau(x){% endif %}</td>
                    <td class="actions">
                        <a class="btn btn-sm btn-secondary" href="{{ path('admin_planning_edit', {id: s.id}) }}">{% if is_granted('PERM_CONFIG_ACTIVITES') %}Modifier{% else %}Détail{% endif %}</a>
                        {% if is_granted('PERM_CONFIG_ACTIVITES') %}
                        <a class="btn btn-sm btn-secondary" href="{{ path('admin_planning_duplicate', {id: s.id}) }}">Dupliquer</a>
                        <form method="post" action="{{ path('admin_planning_delete', {id: s.id}) }}" data-controller="confirm" data-confirm-message-value="Supprimer cette semaine et ses créneaux ?" data-action="submit->confirm#demander">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_semaine_' ~ s.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                        </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6">Aucune semaine.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
