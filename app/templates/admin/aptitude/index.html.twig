{% extends 'base.html.twig' %}
{% block title %}Aptitudes – CN95 Plongée{% endblock %}
{% block body %}
<div class="container">
    <h1 class="header-title">Liste des aptitudes</h1>
    <div class="search-bar">
        <a class="btn" href="{{ path('admin_aptitude_new') }}">Ajouter</a>
    </div>
    <div class="card" style="margin-bottom:16px">
        <form method="post" action="{{ path('admin_aptitude_import') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('import_aptitudes') }}">
            <label for="fichier">Importer des aptitudes (CSV)</label>
            <input type="file" id="fichier" name="fichier" accept=".csv,text/csv" required>
            <button class="btn" type="submit">Importer</button>
            <a href="{{ path('admin_aptitude_import_model') }}" style="margin-left:12px">Télécharger un modèle</a>
            <p class="note">Colonnes : <code>code</code> ; <code>libelle</code> (optionnel) ; <code>ordre</code> (optionnel). Séparateur « ; » ou « , ». Les codes existants sont mis à jour.</p>
        </form>
    </div>
    <div class="table-wrapper">
        <table>
            <thead><tr><th>Ordre</th><th>Code</th><th>Libellé</th><th>Visible</th><th></th></tr></thead>
            <tbody>
            {% for a in aptitudes %}
                <tr>
                    <td>{{ a.ordre }}</td>
                    <td><span class="badge">{{ a.code }}</span></td>
                    <td>{{ a.libelle }}</td>
                    <td>{{ a.visible ? 'Oui' : 'Non' }}</td>
                    <td class="actions">
                        <a class="btn btn-sm btn-secondary" href="{{ path('admin_aptitude_edit', {id: a.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('admin_aptitude_delete', {id: a.id}) }}" onsubmit="return confirm('Supprimer cette aptitude ?')">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_aptitude_' ~ a.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Aucune aptitude.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="note">{{ aptitudes|length }} aptitude(s)</p>
</div>
{% endblock %}
