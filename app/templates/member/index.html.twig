{% extends 'base.html.twig' %}
{% import 'member/_bandeau.html.twig' as m %}
{% block title %}Espace administrateur – CN95 Plongée{% endblock %}
{% block body %}
{# Une section n'est affichée que si l'utilisateur a au moins un élément ; la première affichée est ouverte #}
{% set ouvrir = true %}
<div class="container">
    <details class="section"{{ ouvrir ? ' open' : '' }}>
        <summary class="section-title">Planning</summary>
        {{ m.item('📅', 'Planning des entraînements', 'Lundi et vendredi : lieux, lignes d\'eau et aptitudes', path('app_planning')) }}
    </details>
    {% set ouvrir = false %}

    {% if is_granted('PERM_INVITATIONS') and activitesExternes|length > 0 %}
    <details class="section"{{ ouvrir ? ' open' : '' }}>
        <summary class="section-title">Invitations aux activités externes</summary>
        {% for activite in activitesExternes %}
            {{ m.item('📝', activite.libelle, 'Consulter et gérer les invitations', path('admin_invitation_index', {activiteExterneId: activite.id})) }}
        {% endfor %}
    </details>
    {% set ouvrir = false %}
    {% endif %}

    {% if is_granted('PERM_ACTIVITES_EXTERNES') or is_granted('PERM_COMMUNICATION') %}
    <details class="section"{{ ouvrir ? ' open' : '' }}>
        <summary class="section-title">Communication</summary>
        {% if is_granted('PERM_ACTIVITES_EXTERNES') %}
            {{ m.item('📋', 'Activités externes', 'Consulter et gérer les invitations par activité', path('admin_invitation_index_defaut')) }}
        {% endif %}
        {% if is_granted('PERM_CONFIG_ACTIVITES') %}
            {{ m.item('📅', 'Gestion du planning', 'Créer, modifier et dupliquer les semaines', path('admin_planning_index')) }}
        {% endif %}
        {% if is_granted('PERM_COMMUNICATION') %}
            {{ m.item('💬', 'Communication générale', 'Envoyer des communications générales') }}
            {{ m.item('📱', 'Réseaux sociaux', 'Gérer les publications sur les réseaux sociaux') }}
        {% endif %}
    </details>
    {% set ouvrir = false %}
    {% endif %}

    {% if is_granted('PERM_CONFIG_ACTIVITES') %}
    <details class="section"{{ ouvrir ? ' open' : '' }}>
        <summary class="section-title">Configuration des activités</summary>
        {{ m.item('🎓', 'Gestion des aptitudes', 'Créer, modifier et supprimer les aptitudes', path('admin_aptitude_index')) }}
        {{ m.item('🏊', 'Gestion des activités', 'Créer, modifier et supprimer les activités du planning', path('admin_activite_index')) }}
        {{ m.item('🤿', 'Activités externes', 'Créer et modifier les activités externes (fosse, sorties…)', path('admin_activite_externe_index')) }}
        {{ m.item('🌊', 'Lignes d\'eau', 'Gérer les lignes d\'eau par bassin', path('admin_ligne_eau_index')) }}
    </details>
    {% set ouvrir = false %}
    {% endif %}

    {% if is_granted('PERM_UTILISATEURS') %}
    <details class="section"{{ ouvrir ? ' open' : '' }}>
        <summary class="section-title">Gestion des utilisateurs</summary>
        {{ m.item('👥', 'Liste des utilisateurs', 'Consulter tous les utilisateurs', path('admin_user_index')) }}
        {{ m.item('➕', 'Ajout d\'un utilisateur', 'Créer un nouvel utilisateur', path('admin_user_new')) }}
    </details>
    {% set ouvrir = false %}
    {% endif %}

    {% if is_granted('PERM_CONFIG_OUTIL') %}
    <details class="section"{{ ouvrir ? ' open' : '' }}>
        <summary class="section-title">⚠️ Configuration de l'outil</summary>
        {{ m.item('✉️', 'Configuration des mails', 'Choisir le système d\'envoi et ses paramètres', path('admin_mail_config')) }}
        {{ m.item('📝', 'Modèles de mails', 'Modifier le texte des mails envoyés par l\'outil', path('admin_mail_template_index')) }}
    </details>
    {% set ouvrir = false %}
    {% endif %}
</div>
{% endblock %}
