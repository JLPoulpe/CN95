{% extends 'base.html.twig' %}
{% block title %}Aptitudes – CN95 Plongée{% endblock %}
{% block body %}
<div class="container">
    <h1 class="header-title">Liste des aptitudes</h1>
    <div class="search-bar">
        <a class="btn" href="{{ path('admin_aptitude_new') }}">Ajouter</a>
    </div>
    <div class="table-wrapper">
        <table>
            <thead><tr><th>Ordre</th><th>Code</th><th>Libellé</th><th>Visible</th><th></th></tr></thead>
            <tbody>
            {% for a in aptitudes %}
                <tr>
                    <td>{{ a.ordre }}</td>
                    <td><span class="badge">{{ a.code }}</span></td>
                    <td>{{ a.libelle }}</td>
                    <td>{{ a.visible ? 'Oui' : 'Non' }}</td>
                    <td class="actions">
                        <a class="btn btn-sm btn-secondary" href="{{ path('admin_aptitude_edit', {id: a.id}) }}">Modifier</a>
                        <form method="post" action="{{ path('admin_aptitude_delete', {id: a.id}) }}" data-controller="confirm" data-confirm-message-value="Supprimer cette aptitude ?" data-action="submit->confirm#demander">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_aptitude_' ~ a.id) }}">
                            <button type="submit" class="btn btn-sm btn-danger">Supprimer</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Aucune aptitude.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="note">{{ aptitudes|length }} aptitude(s)</p>
</div>
{% endblock %}
