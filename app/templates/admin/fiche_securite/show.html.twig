{% extends 'base.html.twig' %}
{% block title %}Fiche de sécu – {{ invitation.activite.libelle }} – CN95 Plongée{% endblock %}

{% macro personne(user, invitation) %}
    {% import 'admin/_caci.html.twig' as c %}
    <li class="fiche-personne" draggable="true" data-user-id="{{ user.id }}" data-action="dragstart->fiche-securite#debut dragend->fiche-securite#fin">
        <span class="fiche-personne-nom">{{ user.prenom }} {{ user.nom }} {{ c.caci(user, invitation.date) }}</span>
        <span class="fiche-personne-info">{{ user.aptitude }}{% if user.aptitudePreparee %} → {{ user.aptitudePreparee }}{% endif %}{% if user.estMineur(invitation.date) %} · mineur{% endif %}</span>
    </li>
{% endmacro %}

{% macro exterieur(numero) %}
    <li class="fiche-personne" draggable="true" data-exterieur="{{ numero }}" data-action="dragstart->fiche-securite#debut dragend->fiche-securite#fin">
        <span class="fiche-personne-nom">Moniteur extérieur {{ numero }}</span>
        <span class="fiche-personne-info">Sans compte, peut être moniteur de palanquée</span>
    </li>
{% endmacro %}

{% block body %}
{% import 'admin/_caci.html.twig' as c %}
<div class="container"
     data-controller="fiche-securite caci"
     data-fiche-securite-url-value="{{ path('admin_fiche_securite_deplacer', {id: invitation.id}) }}"
     data-fiche-securite-token-value="{{ csrf_token('fiche_securite_' ~ invitation.id) }}">
    <p class="retour"><a href="{{ path('admin_invitation_inscrits', {id: invitation.id}) }}">← Inscrits – {{ invitation.activite.libelle }} du {{ invitation.date|date('d/m/Y') }}</a></p>
    <h1 class="header-title">Fiche de sécu – {{ invitation.activite.libelle }} du {{ invitation.date|date('d/m/Y') }}</h1>

    <p class="hint">
        {{ nb_inscrits }} inscrit(s) en liste principale · {{ fiche.palanquees|length }} palanquée(s).
        Une palanquée compte 5 personnes : un moniteur et 4 plongeurs. Les étiquettes « Moniteur extérieur » (sans compte) peuvent aussi être moniteurs de palanquée.
        Glissez-déposez une personne pour la changer de palanquée ; les modifications sont enregistrées automatiquement.
    </p>
    <div class="actions-bar">
        <form method="post" action="{{ path('admin_fiche_securite_ajouter', {id: invitation.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('fiche_securite_' ~ invitation.id) }}">
            <button class="btn" type="submit">Ajouter une palanquée</button>
        </form>
        <form method="post" action="{{ path('admin_fiche_securite_synchroniser', {id: invitation.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('fiche_securite_' ~ invitation.id) }}">
            <button class="btn btn-secondary" type="submit">Mettre à jour depuis les inscrits</button>
        </form>
    </div>

    <div data-fiche-securite-target="plateau">
        <div class="fiche-palanquees">
            {% for palanquee in fiche.palanquees %}
                <section class="card fiche-palanquee{% if palanquee.avertissements %} fiche-alerte{% endif %}"
                         data-fiche-securite-target="zone" data-palanquee-id="{{ palanquee.id }}"
                         data-action="dragover->fiche-securite#survol dragleave->fiche-securite#sortie drop->fiche-securite#depot">
                    <div class="fiche-entete">
                        <h2 class="card-titre">Palanquée {{ palanquee.numero }} <span class="muted">({{ palanquee.membres|length }} / 5)</span></h2>
                        <select class="fiche-ajout" aria-label="Ajouter un plongeur à la palanquée {{ palanquee.numero }}"
                                data-action="change->fiche-securite#ajouter">
                            <option value="">+ Plongeur…</option>
                            {% for groupe in groupes_ajout %}
                                <optgroup label="{{ groupe.libelle }}">
                                    {% for user in groupe.users %}<option value="{{ user.id }}">{{ user.prenom }} {{ user.nom }}</option>{% endfor %}
                                    {% for numero in groupe.exterieurs %}<option value="ext:{{ numero }}">Moniteur extérieur {{ numero }}</option>{% endfor %}
                                </optgroup>
                            {% endfor %}
                        </select>
                        <form method="post" action="{{ path('admin_fiche_securite_supprimer', {id: invitation.id, palanqueeId: palanquee.id}) }}"
                              data-controller="confirm" data-confirm-message-value="Supprimer cette palanquée ? Ses membres retournent dans les restants." data-action="submit->confirm#demander">
                            <input type="hidden" name="_token" value="{{ csrf_token('fiche_securite_' ~ invitation.id) }}">
                            <button class="btn btn-sm btn-danger" type="submit" aria-label="Supprimer la palanquée {{ palanquee.numero }}">Supprimer</button>
                        </form>
                    </div>
                    {% for message in palanquee.avertissements %}<p class="fiche-avertissement">⚠ {{ message }}</p>{% endfor %}
                    <ul class="fiche-liste">
                        {% for membre in palanquee.membresOrdonnes %}
                            {% set estChef = membre is same as palanquee.chefMembre %}
                            <li class="fiche-personne{% if estChef %} fiche-chef{% endif %}" draggable="true"
                                {% if membre.exterieur %}data-exterieur="{{ membre.exterieur }}"{% else %}data-user-id="{{ membre.user.id }}"{% endif %}
                                data-action="dragstart->fiche-securite#debut dragend->fiche-securite#fin">
                                <span class="fiche-personne-nom">
                                    {% if estChef %}<span class="badge badge-yellow">Moniteur</span>{% endif %}
                                    {{ membre.libelle }}
                                    {% if membre.user %}{{ c.caci(membre.user, invitation.date) }}{% endif %}
                                </span>
                                <button type="button" class="btn-retirer" data-action="click->fiche-securite#retirer"
                                        aria-label="Retirer {{ membre.libelle }} de la palanquée">✕</button>
                                {% if membre.user %}<span class="fiche-personne-info">{{ membre.user.aptitude }}{% if membre.user.aptitudePreparee %} → {{ membre.user.aptitudePreparee }}{% endif %}{% if membre.user.estMineur(invitation.date) %} · mineur{% endif %}</span>{% endif %}
                            </li>
                        {% else %}
                            <li class="fiche-vide">Déposez ici une personne.</li>
                        {% endfor %}
                    </ul>
                    <div class="fiche-params" data-palanquee-id="{{ palanquee.id }}">
                        <label>Profondeur max. (m)
                            <input type="number" min="0" max="100" step="1" inputmode="numeric" name="profondeurMax" value="{{ palanquee.profondeurMax }}" data-action="change->fiche-securite#parametres">
                        </label>
                        <label>DTR (min)
                            <input type="number" min="0" max="999" step="1" inputmode="numeric" name="dtr" value="{{ palanquee.dtr }}" data-action="change->fiche-securite#parametres">
                        </label>
                        <label>Durée (min)
                            <input type="number" min="0" max="999" step="1" inputmode="numeric" name="duree" value="{{ palanquee.duree }}" data-action="change->fiche-securite#parametres">
                        </label>
                        <label>Type
                            <select name="type" data-action="change->fiche-securite#parametres">
                                <option value="">—</option>
                                {% for cle, libelle in constant('App\\Entity\\Palanquee::TYPES') %}<option value="{{ cle }}"{% if palanquee.type == cle %} selected{% endif %}>{{ libelle }}</option>{% endfor %}
                            </select>
                        </label>
                    </div>
                </section>
            {% else %}
                <p class="muted">Aucune palanquée : aucun moniteur n'est inscrit. Ajoutez-en une pour commencer.</p>
            {% endfor %}
        </div>

        <div class="inscrits-colonnes" style="margin-top:32px">
            <section class="card fiche-restants" data-fiche-securite-target="zone" data-palanquee-id=""
                     data-action="dragover->fiche-securite#survol dragleave->fiche-securite#sortie drop->fiche-securite#depot">
                <h2 class="card-titre">Moniteurs restants ({{ restants.moniteurs|length }})</h2>
                <ul class="fiche-liste">
                    {% for user in restants.moniteurs %}{{ _self.personne(user, invitation) }}{% endfor %}
                    {% for numero in restants.exterieurs %}{{ _self.exterieur(numero) }}{% endfor %}
                    {% if not restants.moniteurs and not restants.exterieurs %}<li class="fiche-vide">Aucun moniteur restant.</li>{% endif %}
                </ul>
            </section>
            <section class="card fiche-restants" data-fiche-securite-target="zone" data-palanquee-id=""
                     data-action="dragover->fiche-securite#survol dragleave->fiche-securite#sortie drop->fiche-securite#depot">
                <h2 class="card-titre">Adhérents restants ({{ restants.adherents|length }})</h2>
                <ul class="fiche-liste">
                    {% for user in restants.adherents %}{{ _self.personne(user, invitation) }}{% else %}<li class="fiche-vide">Aucun adhérent restant.</li>{% endfor %}
                </ul>
            </section>
        </div>
    </div>
    <div class="alert" data-fiche-securite-target="erreur" hidden role="alert"></div>

    <dialog class="modal modal-caci" data-caci-target="dialogue">
        <h2>CACI</h2>
        <p data-caci-target="nom"></p>
        <p>Date de fin de validité : <strong data-caci-target="fin"></strong></p>
        <form method="dialog" class="modal-actions"><button class="btn btn-secondary">Fermer</button></form>
    </dialog>
</div>
{% endblock %}
