{# Variables : absent, activite, jour, date, lieux, groupes. #}
<p><strong>{{ absent }}</strong> ne pourra pas encadrer le créneau suivant : un renfort est le bienvenu.</p>
<ul>
    <li>Activité : <strong>{{ activite }}</strong></li>
    <li>Quand : <strong>{{ jour }} {{ date }}</strong></li>
    {% if lieux %}<li>Lieu : {{ lieux }}</li>{% endif %}
    {% if groupes %}<li>Groupes : {{ groupes }}</li>{% endif %}
</ul>
