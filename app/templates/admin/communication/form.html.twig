{% extends 'base.html.twig' %}
{% block title %}{{ communication ? 'Modifier la communication' : 'Nouvelle communication' }} – CN95 Plongée{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('vendor/quill/dist/quill.snow.css') }}">
{% endblock %}
{% block body %}
<div class="container">
    <p class="retour"><a href="{{ path('admin_communication_index') }}">← Communications</a></p>
    <h1 class="header-title">{{ communication ? 'Modifier la communication' : 'Nouvelle communication' }}</h1>
    <div class="card">
        <p class="hint">Le mail contiendra « Bonjour à toutes et à tous, », votre contenu, puis la signature du bureau. Les destinataires se choisissent à l'étape suivante, avant l'envoi.</p>
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <button class="btn" type="submit">Enregistrer</button>
            <a href="{{ communication ? path('admin_communication_show', {id: communication.id}) : path('admin_communication_index') }}" style="margin-left:12px">Annuler</a>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
