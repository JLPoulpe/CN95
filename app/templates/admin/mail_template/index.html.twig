{% extends 'base.html.twig' %}
{% block title %}Modèles de mails – CN95 Plongée{% endblock %}
{% block body %}
<div class="container container-wide">
    <p><a href="{{ path('app_member') }}">← Espace administrateur</a></p>
    <h1 class="header-title">Modèles de mails</h1>
    <p style="margin-bottom:20px"><a class="btn" href="{{ path('admin_mail_template_new') }}">Créer un modèle</a></p>

    <div class="card" style="font-size:14px;color:#4b5563">
        <p><strong>Ce que contient un mail :</strong> le message « Bonjour à toutes et à tous, », puis le commentaire de l'invitation, les liens de réponse (ajoutés automatiquement), le texte du modèle et la signature.</p>
        <p style="margin-top:8px"><strong>Variables utilisables dans le contenu :</strong>
            <code>{{ '{{date}}' }}</code> date ·
            <code>{{ '{{activite}}' }}</code> activité ·
            <code>{{ '{{prenom}}' }}</code> et <code>{{ '{{nom}}' }}</code> du destinataire ·
            <code>{{ '{{membre}}' }}</code> membre concerné (désistement).
        </p>
    </div>

    <div class="table-wrapper">
        <table>
            <thead><tr><th>Nom</th><th>Utilisé pour</th><th>Par défaut</th><th>Modifié le</th><th></th></tr></thead>
            <tbody>
            {% for template in templates %}
                <tr>
                    <td><strong>{{ template.nom }}</strong></td>
                    <td>{{ template.type.label }}</td>
                    <td>{% if template.parDefaut %}<span class="badge badge-yellow">Par défaut</span>{% endif %}</td>
                    <td>{{ template.updatedAt|date('d/m/Y H:i') }}</td>
                    <td class="actions">
                        <a class="btn btn-sm btn-secondary" href="{{ path('admin_mail_template_edit', {id: template.id}) }}">Modifier</a>
                        <a class="btn btn-sm btn-secondary" href="{{ path('admin_mail_template_apercu', {id: template.id}) }}" target="_blank" data-turbo="false">Aperçu</a>
                        {% if not template.parDefaut %}
                            <form method="post" action="{{ path('admin_mail_template_par_defaut', {id: template.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('mail_template_' ~ template.id) }}">
                                <button class="btn btn-sm btn-secondary" type="submit">Définir par défaut</button>
                            </form>
                            <form method="post" action="{{ path('admin_mail_template_delete', {id: template.id}) }}"
                                  onsubmit="return confirm('Supprimer le modèle « {{ template.nom|e('js') }} » ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('mail_template_' ~ template.id) }}">
                                <button class="link-danger" type="submit">Supprimer</button>
                            </form>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Aucun modèle de mail.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
